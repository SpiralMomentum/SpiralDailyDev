<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/widget_label_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 기간" android:textColor="#4C5468" android:textSize="12sp" />
        <TextView android:id="@+id/widget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#171B24" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_ratio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2F4A7A" android:textSize="14sp" />
        <TextView android:id="@+id/widget_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#4C5468" android:textSize="12sp" />
        <TextView android:id="@+id/widget_as_of" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#4C5468" android:textSize="10sp" />
        <TextView android:id="@+id/widget_pending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="#C2410C" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
