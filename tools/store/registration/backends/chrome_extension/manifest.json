{
  "manifest_version": 3,
  "name": "Play Console Registration",
  "key": "",
  "version": "1.0",
  "description": "Play Console 앱 등록 자동화",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://play.google.com/*",
    "http://localhost:7892/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/console/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
