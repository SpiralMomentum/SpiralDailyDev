require "yaml"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

REPO_ROOT = File.expand_path('..', __dir__)

def load_app_config(app_name)
  config = YAML.load_file(File.join(REPO_ROOT, "release.yaml"))
  app = config.dig("apps", app_name)
  UI.user_error!("App '#{app_name}' not found in release.yaml") unless app
  app
end

def setup_asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true
  )
end

def generate_export_options_plist(project_dir, bundle_id, team_id, profile_name)
  plist_path = File.join(project_dir, "ios", "ExportOptions.plist")
  plist_content = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store</string>
      <key>teamID</key>
      <string>#{team_id}</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{bundle_id}</key>
        <string>#{profile_name}</string>
      </dict>
    </dict>
    </plist>
  PLIST
  File.write(plist_path, plist_content)
  UI.message("Generated ExportOptions.plist at #{plist_path}")
end

# ---------------------------------------------------------------------------
# Android lanes
# ---------------------------------------------------------------------------

platform :android do
  desc "Deploy to Google Play internal track"
  lane :deploy_internal do |options|
    app_name = options[:app]
    UI.user_error!("Missing required parameter :app") unless app_name
    config = load_app_config(app_name)
    app_id = config["appId"]
    project_path = config["projectPath"]

    project_dir = File.join(REPO_ROOT, project_path)

    Dir.chdir(project_dir) do
      sh("flutter", "build", "appbundle", "--release")
    end

    aab_path = File.join(project_dir, "build", "app", "outputs", "bundle", "release", "app-release.aab")

    upload_to_play_store(
      package_name: app_id,
      aab: aab_path,
      track: "internal",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Google Play production track"
  lane :deploy_production do |options|
    app_name = options[:app]
    UI.user_error!("Missing required parameter :app") unless app_name
    config = load_app_config(app_name)
    app_id = config["appId"]
    project_path = config["projectPath"]

    project_dir = File.join(REPO_ROOT, project_path)

    Dir.chdir(project_dir) do
      sh("flutter", "build", "appbundle", "--release")
    end

    aab_path = File.join(project_dir, "build", "app", "outputs", "bundle", "release", "app-release.aab")

    upload_to_play_store(
      package_name: app_id,
      aab: aab_path,
      track: "production",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

# ---------------------------------------------------------------------------
# iOS lanes
# ---------------------------------------------------------------------------

platform :ios do
  desc "Deploy to TestFlight"
  lane :deploy_testflight do |options|
    app_name = options[:app]
    UI.user_error!("Missing required parameter :app") unless app_name
    config = load_app_config(app_name)
    ios_bundle_id = config["iosBundleId"]
    project_path = config["projectPath"]

    setup_asc_api_key

    create_keychain(
      name: "fastlane_keychain",
      password: "fastlane_keychain",
      timeout: 1800,
      default_keychain: true,
      unlock: true,
      lock_when_sleeps: false
    )

    match(
      app_identifier: ios_bundle_id,
      type: "appstore",
      readonly: true,
      keychain_name: "fastlane_keychain",
      keychain_password: "fastlane_keychain"
    )

    project_dir = File.join(REPO_ROOT, project_path)
    profile_name = "match AppStore #{ios_bundle_id}"
    xcodeproj = File.join(project_dir, "ios", "Runner.xcodeproj")

    Dir.chdir(project_dir) do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end

    update_code_signing_settings(
      path: xcodeproj,
      use_automatic_signing: false,
      team_id: "BXMP99D98Z",
      bundle_identifier: ios_bundle_id,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"]
    )

    build_app(
      workspace: File.join(project_dir, "ios", "Runner.xcworkspace"),
      scheme: "Runner",
      clean: false,
      output_directory: File.join(project_dir, "build", "ios", "ipa"),
      export_options: {
        method: "app-store",
        teamID: "BXMP99D98Z",
        signingStyle: "manual",
        provisioningProfiles: {
          ios_bundle_id => profile_name
        }
      }
    )

    upload_to_testflight(
      app_identifier: ios_bundle_id,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :deploy_appstore do |options|
    app_name = options[:app]
    UI.user_error!("Missing required parameter :app") unless app_name
    config = load_app_config(app_name)
    ios_bundle_id = config["iosBundleId"]
    project_path = config["projectPath"]

    setup_asc_api_key

    create_keychain(
      name: "fastlane_keychain",
      password: "fastlane_keychain",
      timeout: 1800,
      default_keychain: true,
      unlock: true,
      lock_when_sleeps: false
    )

    match(
      app_identifier: ios_bundle_id,
      type: "appstore",
      readonly: true,
      keychain_name: "fastlane_keychain",
      keychain_password: "fastlane_keychain"
    )

    project_dir = File.join(REPO_ROOT, project_path)
    profile_name = "match AppStore #{ios_bundle_id}"
    xcodeproj = File.join(project_dir, "ios", "Runner.xcodeproj")

    Dir.chdir(project_dir) do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end

    update_code_signing_settings(
      path: xcodeproj,
      use_automatic_signing: false,
      team_id: "BXMP99D98Z",
      bundle_identifier: ios_bundle_id,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"]
    )

    build_app(
      workspace: File.join(project_dir, "ios", "Runner.xcworkspace"),
      scheme: "Runner",
      clean: false,
      export_options: {
        method: "app-store",
        teamID: "BXMP99D98Z",
        signingStyle: "manual",
        provisioningProfiles: {
          ios_bundle_id => profile_name
        }
      }
    )

    metadata_dir = File.join(REPO_ROOT, "fastlane", "metadata", app_name)
    screenshots_dir = File.join(metadata_dir, "screenshots")
    rating_config = File.join(metadata_dir, "rating_config.json")

    has_screenshots = Dir.exist?(screenshots_dir) && !Dir.glob(File.join(screenshots_dir, "**", "*.png")).empty?

    upload_to_app_store(
      app_identifier: ios_bundle_id,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      metadata_path: metadata_dir,
      screenshots_path: has_screenshots ? screenshots_dir : nil,
      app_rating_config_path: File.exist?(rating_config) ? rating_config : nil,
      submit_for_review: has_screenshots,
      automatic_release: true,
      force: true,
      skip_screenshots: !has_screenshots,
      skip_metadata: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        export_compliance_compliance_required: false,
        export_compliance_platform: "ios"
      }
    )
  end
end
